# Root Git Ignore for FixMyCity

# Dependencies
node_modules/
vendor/

# Next.js frontend builds & cache
frontend/.next/
frontend/out/
frontend/build/

# Frontend environment & cache
frontend/.env*.local
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Backend environment & storage
backend/.env
backend/.env.backup
backend/.env.production
backend/storage/*.key
backend/public/storage
backend/storage/pail/
backend/.phpunit.result.cache

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# System & IDE files
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
.fleet/
.nova/
.zed/

# Reference prototype folder
UI/

